{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gibp-background-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "GROWTH_QUEUE",
        "queue": "gibp-growth-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "gibp-growth-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "GROWTH_DB",
      "database_name": "gibp-growth",
      "database_id": "89e36512-deda-42a0-ad8f-5f0926b750ba",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SEND_MODE": "dry_run",
    "FROM_EMAIL": "GIBP Commercial Desk <partnerships@gibp.global>",
    "PUBLIC_BASE_URL": "https://growth.gibp.global",
    "GIBP_SITE_URL": "https://www.gibp.global",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_DAILY_CALL_CAP": "30",
    "DAILY_SEND_CAP": "50",
    "DAILY_NEW_OUTREACH_CAP": "20",
    "RAMP_START_CAP": "5",
    "CONTACT_SCANS_PER_HOUR": "6",
    "APOLLO_CANDIDATE_SEARCHES_PER_HOUR": "3",
    "APOLLO_ENRICHMENT_DAILY_CAP": "0",
    "APOLLO_MIN_LEAD_CREDITS_RESERVE": "20",
    "RFP_MIN_SCORE": "70",
    "RFP_HANDOFF_SCORE": "82",
    "SERIOUS_THRESHOLD": "85",
    "DEFAULT_JURISDICTION_MODE": "monitor_only",
    "RETENTION_DAYS": "365",
    "BUSINESS_POSTAL_ADDRESS": "82a James Carter Road, Bury St. Edmunds, IP28 7DE, United Kingdom",
    "HANDOFF_TO": "martin@theraeburngroup.com",
    "GIBP_APPROVED_FACTS": "GIBP is a provider-neutral financial intent, policy, liquidity and execution layer designed for institutional value movement across banks, payment rails and digital money. GIBP presents responsible providers and applicable terms before any live regulated service. Public information is available at https://www.gibp.global."
  },
  "routes": [
    {
      "pattern": "growth.gibp.global",
      "custom_domain": true
    }
  ]
}
